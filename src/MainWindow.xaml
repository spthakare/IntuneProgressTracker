<Window x:Class="IntuneProgressTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Company Device Setup" Width="760" Height="610"
        WindowStartupLocation="Manual" ResizeMode="CanMinimize"
        Closing="Window_Closing" Background="#F7F7F7" ShowInTaskbar="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Setting up your device" FontSize="24" FontWeight="SemiBold" Foreground="#1F1F1F"/>
                <TextBlock x:Name="PhaseText" Text="Preparing…" Margin="0,5,0,0" Foreground="#555" FontSize="13"/>
            </StackPanel>
            <Button Content="Refresh" Width="82" Height="30" HorizontalAlignment="Right" Click="RefreshButton_Click"/>
        </Grid>
        <Grid Grid.Row="1" Margin="0,20,0,0">
            <ProgressBar x:Name="OverallProgressBar" Height="10" Minimum="0" Maximum="100"/>
            <TextBlock x:Name="ProgressPercentageText" HorizontalAlignment="Right" Margin="0,-24,0,0" FontWeight="SemiBold"/>
        </Grid>
        <Grid Grid.Row="2" Margin="0,16,0,10">
            <StackPanel>
                <TextBlock x:Name="OverallStatusText" Text="Checking Intune…" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock x:Name="ProgressSummaryText" Text="Waiting for the Intune Management Extension" Margin="0,4,0,0" Foreground="#666"/>
                <TextBlock x:Name="RebootText" Margin="0,5,0,0" Foreground="#A15C00" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>
        <ListView Grid.Row="3" x:Name="AppListView" BorderThickness="0" Background="White">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Application" Width="360" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Type" Width="90" DisplayMemberBinding="{Binding Type}"/>
                    <GridViewColumn Header="Status" Width="150" DisplayMemberBinding="{Binding StatusText}"/>
                    <GridViewColumn Header="Details" Width="300" DisplayMemberBinding="{Binding Details}"/>
                </GridView>
            </ListView.View>
        </ListView>
        <Border Grid.Row="4" Margin="0,12,0,0" Padding="12" Background="#EFEFEF" CornerRadius="6">
            <TextBlock Text="This window will close automatically when all required device applications finish. You may minimize it while setup continues." TextWrapping="Wrap" Foreground="#555"/>
        </Border>
        <TextBlock Grid.Row="5" x:Name="FooterText" Margin="0,10,0,0" FontSize="11" Foreground="#777"/>
    </Grid>
</Window>
